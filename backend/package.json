  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "postinstall": "npx prisma generate --schema=./prisma/schema.prisma",
    "migrate": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "stress-test": "node stress-test.js",
    "stress-test:small": "NUM_ORDENES=10 node stress-test.js",
    "stress-test:medium": "NUM_ORDENES=100 node stress-test.js",
    "stress-test:large": "NUM_ORDENES=500 node stress-test.js",
    "stress-test:extreme": "NUM_ORDENES=2000 node stress-test.js",
    "stress-test:full": "node stress-test-full-flow.js",
    "stress-test:full:small": "NUM_ORDENES=10 node stress-test-full-flow.js",
    "stress-test:full:medium": "NUM_ORDENES=100 node stress-test-full-flow.js",
    "stress-test:full:large": "NUM_ORDENES=500 node stress-test-full-flow.js",
    "stress-test:full:with-prep": "SIMULATE_PREP_TIME=true NUM_ORDENES=10 node stress-test-full-flow.js",
    "clean": "node clean-test-data.js",
    "reset": "node reset-test-database.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
